# HOST-ONLY overrides for the divaa-docker deployment (NOT committed — gitignored).
# Injected into the `app` container via env_file in docker-compose.divaa.yml.
# CodeIgniter 4 reads these as real environment variables, which take precedence
# over the app's synced .env AND over app/Config defaults (CI4's DotEnv never
# overwrites a variable that is already set).
#
# ⚠️ LF line endings only. A trailing CR (\r) from a Windows editor gets baked
#    into these values and breaks MySQL/Redis auth. Keep this file Unix-LF.
#
# ⚠️ Docker env_file syntax: key=value with NO spaces around `=` and NO quotes —
#    unlike a hand-written CI4 .env (`key = value`). Keep it that way; compose
#    would otherwise bake the quotes/spaces into the value.
#
# The base file is production-style; the dev overlay flips CI_ENVIRONMENT to
# development on top of these.
#
# ⚠️ Both password values ship as __INJECT_ON_HOST__ placeholders — the real
#    secrets are injected on the host at deploy time from ~/data/.env, so no
#    credential is ever committed. See docker/README.divaa.md.

CI_ENVIRONMENT=production
app.baseURL=https://{{APP_DOMAIN}}/

# --- Shared MySQL 8.0.46 (reachable as mysql:3306 on the `proxy` network) ---
# Connects as the shared MySQL root user. Database created on the host.
database.default.hostname=mysql
database.default.port=3306
database.default.database={{DB}}
database.default.username=root
database.default.password=__INJECT_ON_HOST__
database.default.DBDriver=MySQLi

# --- Shared Redis 7 (reachable as redis:6379 on the `proxy` network) ---
# CI4 has no built-in REDIS_* convention — wire these into app/Config/Cache.php
# (e.g. $redis['host'] = getenv('REDIS_HOST') ?: $redis['host']) if the app uses
# the redis cache handler. cache.prefix is a native CI4 override and namespaces
# keys so we never collide with other projects on the shared Redis.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__INJECT_ON_HOST__
REDIS_PREFIX={{REDIS_PREFIX}}
cache.prefix={{REDIS_PREFIX}}

# --- Shared Mailpit fake SMTP (reachable as mailpit:1025 on the `proxy` network) ---
# Every message the app "sends" is captured; nothing leaves the network. Read it
# at https://mailpit.app.test (needs a hosts entry — see docker/README.divaa.md).
# No auth: Mailpit accepts any or no credentials; SMTPCrypto stays empty.
email.protocol=smtp
email.SMTPHost=mailpit
email.SMTPPort=1025
email.SMTPUser=
email.SMTPPass=
email.SMTPCrypto=
email.fromEmail=no-reply@{{APP_DOMAIN}}
email.fromName={{SLUG}}

# >>> frontend >>>
# --- Frontend (Vite) ---
# In dev the browser loads JS modules from the Vite origin ({{VITE_DOMAIN}}),
# which is a DIFFERENT origin than the app ({{APP_DOMAIN}}) — so requests made
# from those modules back to the app are cross-origin. Read this variable in
# app/Config/Cors.php (allowedOrigins) or wherever the app configures CORS.
CORS_ALLOWED_ORIGINS=https://{{APP_DOMAIN}},https://{{VITE_DOMAIN}}
# <<< frontend <<<
