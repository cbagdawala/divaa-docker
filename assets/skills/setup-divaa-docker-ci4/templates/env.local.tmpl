# LOCAL Docker dev overrides for {{SLUG}} (topology B). NOT committed — gitignored.
# Loaded into the app container via env_file in docker-compose.local.yml, so these
# override the app's baked .env at runtime (CI4's DotEnv never overwrites a
# variable that is already set in the environment).
#
# ⚠️ LF line endings only (a trailing CR breaks MySQL/Redis auth).
# ⚠️ Docker env_file syntax: key=value, NO spaces around `=`, NO quotes.
# ⚠️ database.default.password: fill in the shared MySQL root password locally
#    (do NOT commit).

CI_ENVIRONMENT=development
app.baseURL=http://localhost:{{WEB_PORT}}/

# --- Shared MySQL over the LAN ---
database.default.hostname={{DIVAA_IP}}
database.default.port=3306
database.default.database={{DB}}
database.default.username=root
database.default.password=
database.default.DBDriver=MySQLi

# --- Local throwaway Redis container (no auth) ---
# Wire into app/Config/Cache.php if the app uses the redis cache handler.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX={{REDIS_PREFIX}}
cache.prefix={{REDIS_PREFIX}}

# --- Shared Mailpit fake SMTP over the LAN (UI: https://mailpit.app.test) ---
# No auth: Mailpit accepts any or no credentials.
email.protocol=smtp
email.SMTPHost={{DIVAA_IP}}
email.SMTPPort=1025
email.SMTPUser=
email.SMTPPass=
email.SMTPCrypto=
email.fromEmail=no-reply@localhost
email.fromName={{SLUG}}

# >>> frontend >>>
# --- Frontend (Vite) ---
CORS_ALLOWED_ORIGINS=http://localhost:{{WEB_PORT}}
# <<< frontend <<<
