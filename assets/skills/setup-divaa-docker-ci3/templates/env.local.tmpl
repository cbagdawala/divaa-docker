# LOCAL Docker dev overrides for {{SLUG}} (topology B). NOT committed — gitignored.
# Loaded into the app container via env_file in docker-compose.local.yml.
# CI3 has no dotenv loader: values reach the app only via getenv() / $_SERVER.
#
# ⚠️ LF line endings only (a trailing CR breaks MySQL/Redis auth).
# ⚠️ DB_PASSWORD: fill in the shared MySQL root password locally (do NOT commit).

CI_ENV=development
BASE_URL=http://localhost:{{WEB_PORT}}/

# --- Shared MySQL over the LAN ---
DB_HOSTNAME={{DIVAA_IP}}
DB_DATABASE={{DB}}
DB_USERNAME=root
DB_PASSWORD=

# --- Local throwaway Redis container (only if your config reads getenv) ---
REDIS_HOST=redis
REDIS_PORT=6379
# Local Redis runs without a password. Keep this EMPTY, not "null" — getenv()
# would hand the app the literal four-character string "null".
REDIS_PASSWORD=
REDIS_PREFIX={{REDIS_PREFIX}}

# --- Shared Mailpit fake SMTP over the LAN (UI: https://mailpit.app.test) ---
# No auth: Mailpit accepts any or no credentials.
MAIL_HOST={{DIVAA_IP}}
MAIL_PORT=1025
