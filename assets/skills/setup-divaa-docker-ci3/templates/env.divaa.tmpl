# HOST-ONLY overrides for the divaa-docker deployment (NOT committed — gitignored).
# Injected into the `app` container via env_file in docker-compose.divaa.yml.
#
# CodeIgniter 3 has NO dotenv loader: these become real environment variables in
# the container, and reach the app only where its config calls getenv() (the
# generator patches application/config/database.php for the DB_* values) or
# reads $_SERVER (the stock index.php does, for CI_ENV).
#
# ⚠️ LF line endings only. A trailing CR (\r) from a Windows editor gets baked
#    into these values and breaks MySQL/Redis auth. Keep this file Unix-LF.
#
# The base file is production-style; the dev overlay flips CI_ENV=development
# on top of these.
#
# ⚠️ Both *_PASSWORD values ship as __INJECT_ON_HOST__ placeholders — the real
#    secrets are injected on the host at deploy time from ~/data/.env, so no
#    credential is ever committed. See docker/README.divaa.md.

# Stock CI3 index.php: define('ENVIRONMENT', isset($_SERVER['CI_ENV']) ? $_SERVER['CI_ENV'] : 'development');
CI_ENV=production

# Optional: point application/config/config.php at getenv('BASE_URL') if you want
# the base URL env-driven instead of hardcoded (recommended after the migration —
# a leftover XAMPP-era base_url is the classic wrong-redirect bug).
BASE_URL=https://{{APP_DOMAIN}}/

# --- Shared MySQL 8.0.46 (reachable as mysql:3306 on the `proxy` network) ---
# Connects as the shared MySQL root user. Database created on the host.
# Key names mirror CI3's $db['default'] keys — consumed by the patched
# application/config/database.php via getenv('DB_*').
DB_HOSTNAME=mysql
DB_DATABASE={{DB}}
DB_USERNAME=root
DB_PASSWORD=__INJECT_ON_HOST__

# --- Shared Redis 7 (reachable as redis:6379 on the `proxy` network) ---
# Only consumed if the app's cache/session config reads getenv('REDIS_*') —
# CI3 does not pick these up on its own.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__INJECT_ON_HOST__
# Namespace keys so we never collide with other projects on the shared Redis.
REDIS_PREFIX={{REDIS_PREFIX}}

# --- Shared Mailpit fake SMTP (reachable as mailpit:1025 on the `proxy` network) ---
# Point application/config/email.php at getenv('MAIL_HOST')/getenv('MAIL_PORT')
# and every message the app "sends" is captured; nothing leaves the network. Read
# it at https://mailpit.app.test (needs a hosts entry — see docker/README.divaa.md).
# No auth: Mailpit accepts any or no credentials.
MAIL_HOST=mailpit
MAIL_PORT=1025
